# Copy this file to .env.local and fill in your own key:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
#
# IMPORTANT: none of these use the NEXT_PUBLIC_ prefix. Next.js inlines any
# NEXT_PUBLIC_* variable into the browser bundle at build time, which would
# expose the API key to every visitor. Without the prefix they are readable only
# on the server — which is exactly where the /api Route Handlers read them.

# Your OpenWeatherMap API key. Requires a "One Call by Call" subscription
# (free tier: 1,000 calls/day) on top of a normal account:
# https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_key_here

# Base URLs for the three OpenWeatherMap APIs the app proxies.
# GEOCODING_API_URL is a base path — /api/geocode appends /direct, /zip or
# /reverse itself, so do not put an endpoint on the end of it.
WEATHER_API_URL=https://api.openweathermap.org/data/3.0/onecall
GEOCODING_API_URL=https://api.openweathermap.org/geo/1.0
AIR_POLLUTION_API_URL=https://api.openweathermap.org/data/2.5/air_pollution
